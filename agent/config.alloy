// AWS 각 서버의 Alloy 설정
//   로그: 로컬 alloy/config.alloy와 같은 처리(JSON level·timestamp, 라벨 app·level) + host 라벨
//   호스트 지표: node_exporter와 같은 지표를 Alloy 내장 exporter로 수집해 Prometheus로 전송

// ── 로그 ──
// 서버마다 둘 중 하나만 존재 (PG 서버엔 pg-server.log, 카드사 서버엔 card-server.log, DB 서버엔 없음)
local.file_match "app_logs" {
  path_targets = [
    {"__path__" = "/logs/pg-server.log",   "app" = "PG-Server"},
    {"__path__" = "/logs/card-server.log", "app" = "Card-Server"},
  ]
  sync_period = "5s"
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app_logs.receiver]
}

loki.process "app_logs" {
  stage.json {
    expressions = {
      level     = "level",
      timestamp = "\"@timestamp\"",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = env("LOKI_URL")
  }
  external_labels = {
    host = env("HOST_NAME"),
  }
}

// ── 호스트 지표 ──
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "5s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = env("PROMETHEUS_URL")
  }
  external_labels = {
    host = env("HOST_NAME"),
  }
}
